# ==============================================================================
# Jain Jinvani — Environment Configuration Template
# Copy this file to .env for local web development.
# For Cloudflare Pages, configure these under Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend / Web (Vite)
# ------------------------------------------------------------------------------
# Public URL for Cloudflare R2 audio & scripture media CDN
VITE_R2_MEDIA_URL=https://media.jainjinvani.org

# Optional: Fallback direct Google Sheet Webhook for feedback (if not using /api/feedback)
VITE_GOOGLE_SHEET_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 2. Cloudflare Pages Functions (Serverless Backend)
# Mark sensitive values as "Secret" in Cloudflare Pages dashboard!
# ------------------------------------------------------------------------------

# Admin Authentication (REQUIRED for Admin Dashboard)
# Generate password hash: echo -n "YourStrongPassword" | sha256sum
ADMIN_PASSWORD_HASH=

# Random secret string used to cryptographically sign admin session tokens
ADMIN_SESSION_SECRET=

# Optional: Two-Factor Authentication (Base32 secret)
# When set, 2FA OTP is required on every admin login
ADMIN_TOTP_SECRET=

# Optional: Comma-separated SHA-256 hashes of uppercase emergency recovery codes
ADMIN_RECOVERY_HASHES=

# Google Apps Script Webhook for storing feedback/typo reports in Google Sheets
GOOGLE_SHEET_WEBHOOK_URL=

# Optional: Telegram Notifications for feedback submissions
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Comma-separated CORS allowed origins (overrides default allowlist)
# ALLOWED_ORIGINS=https://jainjinvani.org,https://jainjinvani.pages.dev

# Optional: GitHub sync for public/announcement.json
GITHUB_TOKEN=
GITHUB_REPO=

# ------------------------------------------------------------------------------
# 3. Cloudflare Pages Bindings (Configured in Cloudflare Pages Dashboard)
# ------------------------------------------------------------------------------
# - JINVANI_KV : KV Namespace binding (enables announcements, rate limiting, IP lockout)
# - AI         : Workers AI binding (enables /api/ask LLM responses)
