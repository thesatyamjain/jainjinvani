# Cloudflare Pages HTTP Headers Configuration for Jain Jinvani
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Global Security Headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# SPA HTML: Never cache index.html so users always receive fresh deployments
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# PWA Service Worker: Always revalidate to allow seamless PWA updates
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Large Data Modules (ritual_data, stotra_data, chalisa_data, etc.)
/modules/*
  Cache-Control: public, max-age=2592000, immutable

# Vite hashed bundle assets (fingerprinted js, css)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static images and web fonts
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Web App Manifest
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Sitemap
/sitemap.xml
  Cache-Control: public, max-age=86400
